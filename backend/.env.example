# Backend Environment Configuration
# Copy to .env and fill in your values. Never commit .env to version control.

ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Mining Document Intelligence API"
API_VERSION=v1

# Server (Render injects PORT automatically; set API_HOST to 0.0.0.0)
API_HOST=0.0.0.0
# PORT is injected by Render — do NOT set this in Render env vars
API_PORT=8000

# CORS — set to your Render static site URL (no trailing slash)
CORS_ORIGINS=https://your-frontend.onrender.com

# Google Gemini API (Backend Only — never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Database — use Supabase PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage paths (relative to backend root)
UPLOAD_DIRECTORY=./storage/uploads
PROCESSED_DIRECTORY=./storage/processed
FAISS_INDEX_PATH=./storage/faiss_index/mining_docs.index
FAISS_METADATA_PATH=./storage/faiss_index/mining_docs_metadata.pkl
