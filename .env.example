# ==============================================================================
# Mining Document Intelligence & Reporting Platform (SIH 2026 - PS 26023)
# Global Environment Configuration Template
# Copy relevant sections to backend/.env and frontend/.env — never commit .env
# ==============================================================================

# --- BACKEND (backend/.env) ---

ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Mining Document Intelligence Platform"
API_VERSION=v1

# Server (Render injects PORT automatically)
API_HOST=0.0.0.0
API_PORT=8000

# CORS — your Render static site URL (no trailing slash)
CORS_ORIGINS=https://your-frontend.onrender.com

# Google Gemini API (Backend Only — never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Database — Supabase PostgreSQL connection string
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vector Search (FAISS)
FAISS_INDEX_PATH=./storage/faiss_index/mining_docs.index
FAISS_METADATA_PATH=./storage/faiss_index/mining_docs_metadata.pkl

# File Storage
UPLOAD_DIRECTORY=./storage/uploads
PROCESSED_DIRECTORY=./storage/processed
MAX_UPLOAD_SIZE_MB=50

# --- FRONTEND (frontend/.env) ---

# Backend API URL — your Render web service URL (no trailing slash)
VITE_API_BASE_URL=https://your-backend.onrender.com
